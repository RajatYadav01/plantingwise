# Plantingwise API environment. Copy this file to apps/api/v1/.env for local development.

# Neon PostgreSQL pooled connection URL (from the Neon console).
# This is server-only. Never expose it through an EXPO_PUBLIC_ variable.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# JWT signing secret. Generate a random value of at least 32 characters.
# Required in production; never commit a populated .env file.
JWT_SECRET=replace-with-at-least-32-random-characters

# Runtime environment. Production requires a strong JWT_SECRET.
NODE_ENV=development

# Express listener port inside the host or container.
PORT=4000

# Comma-separated exact origins allowed to make credentialed browser requests.
# Use explicit origins only; wildcard CORS is not appropriate for HttpOnly cookies.
CLIENT_ORIGIN=http://localhost:8081

# Cookie SameSite policy. Use "none" only for cross-site HTTPS deployments.
# Cross-site cookies also require Secure=true (enabled automatically in production).
COOKIE_SAME_SITE=lax

# Optional OpenRouter API key. It must remain on the API server, never in the Expo app.
OPENROUTER_API_KEY=
# Pick an available vision-capable model ID from your OpenRouter account/catalogue.
OPENROUTER_MODEL=openrouter/free
# Optional provider attribution headers.
OPENROUTER_SITE_URL=http://localhost:8081
OPENROUTER_APP_NAME=Plantingwise
