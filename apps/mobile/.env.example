# Expo client configuration. Copy this file to apps/mobile/.env.
# Values prefixed with EXPO_PUBLIC_ are embedded in the app bundle and are visible to users.
# Never put API keys, JWT secrets, database credentials, or other secrets in this file.

# API origin only; the app appends /api/v1 to API requests.
# Same-machine browser: http://localhost:4000
# Android emulator: http://10.0.2.2:4000
# Physical phone: use your development computer's LAN IP, e.g. http://192.168.1.20:4000
EXPO_PUBLIC_API_URL=http://localhost:4000

# Controls app-facing environment labels; allowed values: development, preview, production.
EXPO_PUBLIC_APP_ENV=development
