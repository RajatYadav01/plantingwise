{
	"name": "@plantingwise/mobile",
	"version": "0.1.0",
	"private": true,
	"license": "BSD-3-Clause",
	"main": "expo-router/entry",
	"scripts": {
		"format": "biome format --write",
		"lint": "biome lint",
		"fix": "biome check --write",
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"test:run": "vitest",
		"test:unit": "vitest run unit.test.ts --passWithNoTests",
		"test:integration": "vitest run integration.test.ts --passWithNoTests",
		"test:ui": "vitest --ui",
		"test:coverage": "vitest run --coverage",
		"test:watch": "vitest --watch",
		"dev:android": "expo start --android",
		"dev:ios": "expo start --ios",
		"dev:web": "expo start --web --port 8081",
		"build:web": "expo export --platform web"
	},
	"dependencies": {
		"@expo/vector-icons": "^15.1.1",
		"@plantingwise/config": "workspace:*",
		"@plantingwise/constants": "workspace:*",
		"@plantingwise/schemas": "workspace:*",
		"@plantingwise/types": "workspace:*",
		"@react-native-async-storage/async-storage": "2.2.0",
		"expo": "~58.0.21",
		"expo-constants": "~58.0.15",
		"expo-haptics": "~58.0.7",
		"expo-image-manipulator": "~58.0.16",
		"expo-image-picker": "~58.0.10",
		"expo-notifications": "~58.1.8",
		"expo-router": "~58.0.30",
		"expo-status-bar": "~58.0.4",
		"react": "19.3.0",
		"react-dom": "19.3.0",
		"react-native": "0.88.1",
		"react-native-safe-area-context": "~5.11.1",
		"react-native-screens": "~4.30.1",
		"react-native-web": "^0.21.4"
	},
	"devDependencies": {
		"@babel/core": "^7.29.7",
		"@react-native/babel-preset": "^0.88.1",
		"@testing-library/react-native": "^14.1.0",
		"@types/react": "~19.3.0",
		"test-renderer": "^1.3.1",
		"vitest": "^5.1.0",
		"vitest-native": "^0.13.0"
	}
}
