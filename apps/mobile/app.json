{
	"expo": {
		"name": "Plantingwise",
		"slug": "plantingwise",
		"scheme": "plantingwise",
		"version": "1.0.0",
		"orientation": "portrait",
		"userInterfaceStyle": "light",
		"newArchEnabled": true,
		"ios": {
			"supportsTablet": true,
			"bundleIdentifier": "dev.plantingwise.app",
			"infoPlist": {
				"NSCameraUsageDescription": "Plantingwise uses your camera to help identify plants and review visible symptoms.",
				"NSPhotoLibraryUsageDescription": "Plantingwise uses selected photos to identify plants and review visible symptoms."
			},
			"icon": "./assets/icons/app-icon.png"
		},
		"android": {
			"package": "dev.plantingwise.app",
			"adaptiveIcon": {
				"foregroundImage": "./assets/icons/adaptive-icon.png",
				"monochromeImage": "./assets/icons/monochrome-icon.png",
				"backgroundColor": "#E9F0E4"
			},
			"permissions": ["CAMERA", "POST_NOTIFICATIONS"]
		},
		"web": {
			"bundler": "metro",
			"name": "Plantingwise",
			"favicon": "./assets/icons/favicon.png"
		},
		"plugins": [
			"expo-router",
			[
				"expo-image-picker",
				{
					"photosPermission": "Plantingwise uses photos to help you identify plants.",
					"cameraPermission": "Plantingwise uses the camera to inspect your plants.",
					"microphonePermission": false
				}
			],
			"expo-notifications"
		],
		"icon": "./assets/icons/app-icon.png"
	}
}
